# =====================================================================
# M-WALLET — BP7 LIVE RLS VERIFIER  (npm run bp7:verify-rls)
# =====================================================================
#
# This template is the ONLY .env file that is committed. Copy it to a
# local, git-ignored .env (or just export these in your shell) and fill
# in REAL values only on the machine running the verification.
#
#   cp .env.example .env      # .env is git-ignored
#
# Use THROWAWAY test accounts in a disposable Supabase project. Never put
# a real user's credentials here. Never commit a filled-in copy. Remove
# the values (or delete .env) when you are done — see docs/BP7-CLOUD-DATA.md.
#
# The publishable (anon) key ONLY. A service_role / sb_secret_ key is
# rejected by the verifier.
# ---------------------------------------------------------------------

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

BP7_USER_A_EMAIL=throwaway-a@example.com
BP7_USER_A_PASSWORD=

BP7_USER_B_EMAIL=throwaway-b@example.com
BP7_USER_B_PASSWORD=

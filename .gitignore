# macOS
.DS_Store

# Editor / IDE
.vscode/

# Local working area (findings, probes, screenshots — never committed)
scratchpad/

# Dependencies (M-Wallet has none today; guard against future accidents)
node_modules/

# Local environment files — never commit real credentials.
# .env.example IS allowed to be committed (see negation below).
# The BP7 live RLS verifier reads Supabase URL + publishable key + two
# throwaway test-account credentials from shell env vars OR an ignored
# .env file — never from a committed file.
.env
.env.*
!.env.example

# Local auth config override (holds a real Supabase URL + anon key for
# local development). The committed js/auth/auth-config.example.js is the
# template; js/auth/auth-config.js (the resolver) stays committed.
js/auth/auth-config.local.js
